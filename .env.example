# ── Supabase (required for CMS + admin) ──────────────────────
# Get these from: https://supabase.com → Project Settings → API
# IMPORTANT: URL must NOT end with /rest/v1/
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── EmailJS (required for contact form) ──────────────────────
# Get these from: https://emailjs.com → Account → API Keys
VITE_APP_EMAILJS_SERVICE_ID=your_service_id
VITE_APP_EMAILJS_TEMPLATE_ID=your_template_id
VITE_APP_EMAILJS_PUBLIC_KEY=your_public_key
